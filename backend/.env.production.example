# DirectAdmin production (pcism.com.ng) — copy to backend/.env on the server.
# Do not commit the real .env.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.pcism.com.ng,pcism.com.ng
DJANGO_CSRF_TRUSTED_ORIGINS=https://pcism.com.ng,https://www.pcism.com.ng,https://api.pcism.com.ng
CORS_ALLOWED_ORIGINS=https://pcism.com.ng,https://www.pcism.com.ng
FRONTEND_URL=https://pcism.com.ng

# MySQL from DirectAdmin → MySQL Management (user, password, db name, host often localhost)
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME
DATABASE_URL=mysql://pcismcom_app:CHANGE_ME@localhost:3306/pcismcom_pcs

CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=

MEDIA_ROOT=
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=info@pcism.com.ng
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=info@pcism.com.ng

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
