DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Media: local path (Render disk uses /var/data/media) or S3 when bucket is set
MEDIA_ROOT=
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# Email — console by default; set EMAIL_HOST to send via SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@peaceconceptschool.ng

# Meta WhatsApp Cloud API — leave blank to stub guardian notices locally
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=results_published
WHATSAPP_TEMPLATE_LANG=en

# Paystack — leave blank to hide Pay / virtual accounts locally
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_DVA_BANK=wema-bank

# Production TLS cookies (auto-enabled when DJANGO_DEBUG=false)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

# Gate clock-in marks Late after this local time (HH:MM)
SCHOOL_ATTENDANCE_LATE_AFTER=08:30
